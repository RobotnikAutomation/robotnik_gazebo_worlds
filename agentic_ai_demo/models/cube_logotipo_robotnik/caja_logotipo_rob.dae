  <library_effects>
    <effect id="Material-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <color sid="diffuse">0.8 0.8 0.8 1</color>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Material_001-effect">
      <profile_COMMON>
        <newparam sid="robotnik_automation_logo_jpeg-surface">
          <surface type="2D">
            <init_from>robotnik_automation_logo_jpeg</init_from>
          </surface>
        </newparam>
        <newparam sid="robotnik_automation_logo_jpeg-sampler">
          <sampler2D>
            <source>robotnik_automation_logo_jpeg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="robotnik_automation_logo_jpeg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
    <image id="robotnik_automation_logo_jpeg" name="robotnik_automation_logo_jpeg">
      <init_from>robotnik_automation_logo.jpeg</init_from>
    </image>
  </library_images>
  <library_materials>
