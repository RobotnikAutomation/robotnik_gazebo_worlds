<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="agentic_ai_demo_two_tables_u">
    <physics type="ode">
      <max_step_size>0.02</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="libgz-sim-physics-system.so"/>
    <plugin name="gz::sim::systems::UserCommands" filename="libgz-sim-user-commands-system.so"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="libgz-sim-scene-broadcaster-system.so"/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>
    <plugin name="gz::sim::systems::Contact" filename="libgz-sim-contact-system.so"/>

    <scene>
      <ambient>1 1 1</ambient>
      <grid>false</grid>
      <sky></sky>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- Reutilizamos la sala base para mantener el mismo entorno de demo -->
    <include>
      <uri>model://final_demo</uri>
      <name>final_demo_room</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Dos mesas enfrentadas separadas 5m (centro a centro) -->
    <!-- La linea entre mesas es el eje Y, dejando al robot en (0,0) mirando perpendicular (+X) -->
    <include>
      <uri>model://work_table</uri>
      <name>work_table_north</name>
      <pose>0 2.5 -0.18 0 0 3.1416</pose>
    </include>

    <include>
      <uri>model://work_table</uri>
      <name>work_table_south</name>
      <pose>0 -2.5 -0.18 0 0 0</pose>
    </include>

    <!-- Tres cajas sobre la mesa norte (una deteriorada) -->
    <include>
      <uri>model://damaged_box_small</uri>
      <name>north_table_damaged_box</name>
      <pose>-0.58 2.43 0.87 0 0 -0.18</pose>
    </include>

    <include>
      <uri>model://cube_logo_robonik</uri>
      <name>north_table_cube_logo</name>
      <pose>0.06 2.33 0.96 0 0 0.12</pose>
    </include>

    <include>
      <uri>model://cube_logotipo_robotnik</uri>
      <name>north_table_cube_logotipo</name>
      <pose>0.66 2.43 0.96 0 0 0.28</pose>
    </include>
    
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/OfficeChairGrey</uri>
      <name>office_chair_grey</name>
      <pose>3.21 -1.48 0.0 0 0 -2.13</pose>
    </include>

    <!-- Paredes bajas en U, a ~1m del conjunto de mesas -->
    <model name="low_wall_west">
      <static>true</static>
      <pose>-4.1 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 8.2 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 8.2 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="low_wall_north">
      <static>true</static>
      <pose>0 4.1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.2 0.15 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.2 0.15 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="low_wall_south">
      <static>true</static>
      <pose>0 -4.1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.2 0.15 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.2 0.15 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
