<?xml version="1.0"?>
<package format="2">
  <name>electrical_station_world</name>
  <version>1.2.0</version>
  <description>electrical_station_world package</description>

  <maintainer email="rvasquez@robotnik.es">Robert Vasquez Zavaleta</maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

