<?xml version="1.0"?>
<sdf version="1.7">
  <actor name="station_worker_actor">
    <skin>
      <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>
    <animation name="walk_cycle">
      <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      <interpolate_x>true</interpolate_x>
    </animation>
    <script>
      <loop>true</loop>
      <delay_start>1.0</delay_start>
      <auto_start>true</auto_start>
      <trajectory id="0" type="walk_cycle" tension="0.5">
        <waypoint>
          <time>0.0</time>
          <pose>10 -10 1.0 0 0 0</pose>
        </waypoint>
        <waypoint>
          <time>10.0</time>
          <pose>5 -20 1.0 0 0 0</pose>
        </waypoint>
        <waypoint>
          <time>20.0</time>
          <pose>6 -20 1.0 0 0 1.57</pose>
        </waypoint>
        <waypoint>
          <time>30.0</time>
          <pose>5 -25 1.0 0 0 3.14159</pose>
        </waypoint>
        <waypoint>
          <time>40.0</time>
          <pose>10 -20 1.0 0 0 -1.57</pose>
        </waypoint>
        <waypoint>
          <time>50.0</time>
          <pose>10 -10 1.0 0 0 0</pose>
        </waypoint>
      </trajectory>
    </script>
  </actor>
</sdf>
